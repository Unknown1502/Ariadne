# Ariadne configuration.
#
# Every value below has a working default. The scientific core runs with NO Google Cloud
# account and NO API key: copy this file to .env and change nothing to get a full local
# system. Cloud services are opt-in, one flag at a time.

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- storage -------------------------------------------------------------------------
# Empty DATABASE_URL means the local SQLite ledger under var/. A postgresql+psycopg URL
# switches to Cloud SQL with no other change.
DATABASE_URL=
VAR_DIR=var
RUNTIME_STORE=local            # local | firestore

# --- messaging -----------------------------------------------------------------------
EVENT_BUS=local                # local | pubsub
PUBSUB_MODEL_TOPIC=ariadne.model-events
PUBSUB_DEAD_LETTER_TOPIC=ariadne.dead-letter
MAX_DELIVERY_ATTEMPTS=5

# --- reasoning -----------------------------------------------------------------------
# `stub` is the offline deterministic reasoner. It is NOT a language model, and the API
# and console label it honestly wherever it is used. Set `gemini` for the real thing.
LLM_PROVIDER=stub              # stub | gemini
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
USE_VERTEX_AI=false
# Global ceilings. They tighten per-agent manifests, never loosen them.
AGENT_TIMEOUT_SECONDS=30
AGENT_LOOP_BUDGET=3

# --- google cloud --------------------------------------------------------------------
ENABLE_GOOGLE_CLOUD=false
GCP_PROJECT_ID=
GCP_REGION=asia-south1
FIRESTORE_DATABASE=(default)
CLOUD_STORAGE_BUCKET=

# Not implemented in this build. Setting any of these to true (or setting
# CLOUD_STORAGE_BUCKET) makes startup fail with a clear message rather than accepting a
# flag that does nothing. See docs/limitations.md.
ENABLE_MEMORY_BANK=false
ENABLE_AGENT_GATEWAY=false
ENABLE_MODEL_ARMOR=false

# --- science -------------------------------------------------------------------------
DEFAULT_REPETITIONS=24
DEFAULT_SEED=20260101
# Operational freshness window (audit priority, staleness). Debt scoring uses the
# policy-versioned threshold instead, so debt stays comparable across deployments.
EVIDENCE_VALIDITY_DAYS=90
